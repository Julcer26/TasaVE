<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header + Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Logo Tasa VE"
            android:src="@drawable/widget_brand_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Tasa VE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tab_normal"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="Tasas"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_tab_selected"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="Calc."
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_tab_normal"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="Perfiles"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Rate Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_selected"
            android:gravity="center"
            android:maxLines="1"
            android:text="USD 445.20"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_normal"
            android:gravity="center"
            android:maxLines="1"
            android:text="EUR 518.45"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_normal"
            android:gravity="center"
            android:maxLines="1"
            android:text="USDT 562.10"
            android:textColor="#CBD5E1"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_display_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="$ 100"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:gravity="end"
            android:maxLines="1"
            android:text="Bs. 44,520.00"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Classic 4x4 Keypad Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="2" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="⌫" android:textColor="#FBBF24" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="4" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="5" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="6" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="C" android:textColor="#F87171" android:textSize="12.5sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="7" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="8" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="9" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_key_accent" android:gravity="center" android:text="⇄" android:textColor="#34D399" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="." android:textColor="#CBD5E1" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_key_bg" android:gravity="center" android:text="00" android:textColor="#CBD5E1" android:textSize="12.5sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_key_accent" android:gravity="center" android:text="↗" android:textColor="#34D399" android:textSize="13.5sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
